        </div>
    </header>

    <main>
        <style>
    /* Hero Section */
    .hero-section {
        position: relative;
        height: 100vh;
        min-height: 600px;
        background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1542816417-0983c9c9ad53?auto=format&fit=crop&q=80&w=2070') center/cover no-repeat;
        display: flex;
        align-items: flex-end;
        padding-bottom: 5rem;
        color: white;
    }
    .hero-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 5%;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }
    .hero-text h2 {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 1rem;
        line-height: 1.2;
        max-width: 600px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }
    .hero-text p {
        font-size: 1.1rem;
        max-width: 500px;
        opacity: 0.9;
        margin-bottom: 2rem;
    }
    .hero-nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: color 0.3s;
    }
    .hero-nav:hover {
        color: var(--gold);
    }
    
    /* Tentang Section */
    .tentang-section {
        padding: 5rem 5%;
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
    }
    .section-title {
        color: var(--gold);
        font-size: 2rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        position: relative;
        display: inline-block;
    }
    .section-title::after {
        content: '';
        display: block;
        width: 60px;
        height: 3px;
        background-color: var(--gold);
        margin: 0.5rem auto 0;
        border-radius: 2px;
    }
    .tentang-desc {
        max-width: 800px;
        margin: 0 auto 3rem;
        font-size: 1.05rem;
        color: #555;
    }
    .tentang-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }
    .t-card {
        position: relative;
        border-radius: 15px;
        overflow: hidden;
        height: 250px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        transition: transform 0.3s;
    }
    .t-card:hover {
        transform: translateY(-10px);
    }
    .t-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s;
    }
    .t-card:hover img {
        transform: scale(1.1);
    }
    .t-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 1.5rem;
    }
    .t-card-overlay h4 {
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0;
    }

    /* Profil Section */
    .profil-section {
        background-color: var(--teal);
        padding: 5rem 5%;
        color: white;
        text-align: center;
        border-radius: 40px;
        margin: 0 2%;
    }
    .profil-section .section-title {
        color: white;
    }
    .profil-section .section-title::after {
        background-color: white;
    }
    .profil-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 3rem 2rem;
        max-width: 1000px;
        margin: 3rem auto 0;
    }
    .profil-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .profil-item i {
        font-size: 3rem;
        margin-bottom: 1rem;
        background: rgba(255,255,255,0.2);
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .profil-item h4 {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .profil-item p {
        font-size: 0.9rem;
        opacity: 0.9;
    }
    .profil-bottom {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        max-width: 700px;
        margin: 3rem auto 0;
    }

    /* Berita Section */
    .berita-section {
        padding: 5rem 5%;
        text-align: center;
    }
    .berita-grid {
        display: grid;
        grid-template-columns: 1fr 2fr 1fr;
        gap: 1.5rem;
        max-width: 1200px;
        margin: 3rem auto 0;
        align-items: center;
    }
    .berita-card {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        background: white;
        text-align: left;
        transition: transform 0.3s;
    }
    .berita-card:hover {
        transform: translateY(-5px);
    }
    .berita-card.main-news {
        transform: scale(1.05);
        z-index: 2;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    .berita-card.main-news:hover {
        transform: scale(1.05) translateY(-5px);
    }
    .berita-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }
    .main-news img {
        height: 300px;
    }
    .berita-content {
        padding: 1.5rem;
    }
    .main-news .berita-content {
        padding: 2rem;
        text-align: center;
    }
    .berita-title {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 1rem;
        color: var(--text-main);
    }
    .main-news .berita-title {
        font-size: 1.5rem;
    }
    .berita-desc {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
    }
    .berita-date {
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--teal);
    }
    
    @media (max-width: 992px) {
        .tentang-cards { grid-template-columns: repeat(2, 1fr); }
        .profil-grid, .profil-bottom { grid-template-columns: repeat(2, 1fr); }
        .berita-grid { grid-template-columns: 1fr; }
        .berita-card.main-news { transform: none; }
        .hero-text h2 { font-size: 2.5rem; }
    }
    @media (max-width: 768px) {
        .tentang-cards { grid-template-columns: 1fr; }
        .profil-grid, .profil-bottom { grid-template-columns: 1fr; }
    }
</style>

<!-- Hero Section -->
